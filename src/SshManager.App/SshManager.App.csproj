<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>SshServersManager</AssemblyName>
    <Version>0.1.3</Version>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../SshManager.Core/SshManager.Core.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/app.ico" LogicalName="SshManager.App.Assets.app.ico" /></ItemGroup>
</Project>
